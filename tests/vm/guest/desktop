# desktop - install the distro's GNOME workstation, so that the run looks like
# a desktop install. Waco itself doesn't install a desktop. Runs as root.

set -euo pipefail

# shellcheck source=/dev/null
. /etc/os-release
case $ID in
    ubuntu)
        export DEBIAN_FRONTEND=noninteractive
        apt-get update -qq
        apt-get install -y -qq ubuntu-desktop-minimal >/dev/null
        ;;
    *)
        # Fedora and EL10 call it "Workstation"; EL9 only has "Server with GUI".
        # dnf 4 (EL) installs environments with "group install", dnf 5
        # (Fedora) with "install @id".
        for env in workstation-product-environment graphical-server-environment; do
            if dnf environment list --hidden 2>/dev/null | grep -q "($env)" ||
                dnf group list --hidden -v 2>/dev/null | grep -q "($env)"; then
                dnf group install -y -q "$env" || dnf install -y -q "@$env"
                break
            fi
        done
        # Desktop installs come with firewalld running; Fedora's cloud box
        # lacks it even after the Workstation group (seen with Fedora 45).
        dnf install -y -q firewalld
        systemctl enable --now firewalld
        ;;
esac
systemctl set-default graphical.target
systemctl isolate graphical.target
