{# Workstation as Code
   Copyright Nicola Musatti 2026.

   Test image template, rendered by Molecule's podman driver. The image name is
   "waco-<distro>"; to support a new distribution add it to the map below. #}
{% set distro = item.image | regex_replace('^waco-', '') %}
{% set bases = {
    'rockylinux10': 'quay.io/rockylinux/rockylinux:10',
    'rockylinux9': 'quay.io/rockylinux/rockylinux:9',
    'centos-stream10': 'quay.io/centos/centos:stream10',
    'centos-stream9': 'quay.io/centos/centos:stream9',
    'fedora44': 'registry.fedoraproject.org/fedora:44',
    'fedora43': 'registry.fedoraproject.org/fedora:43',
    'ubuntu2604': 'docker.io/library/ubuntu:26.04',
    'ubuntu2404': 'docker.io/library/ubuntu:24.04',
    'ubuntu2204': 'docker.io/library/ubuntu:22.04',
} %}
FROM {{ bases[distro] }}

{% if distro.startswith('ubuntu') %}
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && \
    apt-get install -y --no-install-recommends acl ca-certificates python3 python3-apt sudo systemd systemd-sysv && \
    apt-get clean
# The package lists are kept, as on a freshly installed system.
# Where the host kernel has AppArmor (GitHub's runners) but the container has no
# securityfs, libapparmor's aa_is_enabled() fails and so does every snap hook
# ("aa_is_enabled() failed unexpectedly"). Make AppArmor look disabled inside the
# container, as on a host without it; a no-op where the host has no AppArmor.
RUN printf 'N\n' > /etc/waco-test-apparmor-disabled && \
    printf '%s\n' \
      '[Unit]' \
      'Description=Make AppArmor look disabled in the test container' \
      'DefaultDependencies=no' \
      'ConditionPathExists=/sys/module/apparmor/parameters/enabled' \
      'ConditionPathExists=!/sys/kernel/security/apparmor' \
      'Before=sysinit.target snapd.service snapd.socket snapd.apparmor.service' \
      '[Service]' \
      'Type=oneshot' \
      'RemainAfterExit=yes' \
      'ExecStart=/bin/mount --bind /etc/waco-test-apparmor-disabled /sys/module/apparmor/parameters/enabled' \
      '[Install]' \
      'WantedBy=sysinit.target' \
      > /etc/systemd/system/waco-test-no-apparmor.service && \
    mkdir -p /etc/systemd/system/sysinit.target.wants && \
    ln -s ../waco-test-no-apparmor.service /etc/systemd/system/sysinit.target.wants/
{% elif distro.startswith('fedora') %}
RUN dnf -y install acl python3 python3-libdnf5 sudo systemd && dnf clean all
{% else %}
RUN dnf -y install acl python3 sudo systemd && dnf clean all
{% endif %}

CMD ["/sbin/init"]
