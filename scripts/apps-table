#!/usr/bin/env python3

# Workstation as Code
# Copyright Nicola Musatti 2026.

"""apps-table - generate docs/apps.md, the app x distribution table.

The table comes from the app catalog, roles/apps/vars/catalog.yml, resolved for
each distribution in extensions/molecule/distros. A cell is marked as verified
when the distribution's log of the apps scenario shows a successful verify step
and the same source as the cell, so a source changed since the last test run
loses its mark. Run the scenarios first with scripts/molecule-matrix -s apps.

--check compares docs/apps.md with the catalog, ignoring the marks, because the
logs are not kept in the repository. It exits with status 1 if they differ.
"""

import argparse
import json
import re
import sys
from pathlib import Path

import yaml

ROOT = Path(__file__).resolve().parent.parent
CATALOG = ROOT / 'roles/apps/vars/catalog.yml'
DISTROS = ROOT / 'extensions/molecule/distros'
OUTPUT = ROOT / 'docs/apps.md'
LOGS = ROOT / '.cache/molecule-logs'

# As apps_kinds in roles/apps/vars/main.yml
KINDS = ['package', 'flatpak', 'snap', 'role', 'unavailable']
MARK = ' ✓'

HEADER = f"""\
# Apps by distribution

<!-- Generated by scripts/apps-table from roles/apps/vars/catalog.yml. Do not edit. -->

Where each app in the catalog comes from on each distribution. A{MARK} means that the `apps`
scenario passed on that distribution with that source.
"""


def platform_keys(distro):
    """The catalog keys for a distribution, as apps_platform_keys in roles/apps/vars/main.yml."""
    if match := re.fullmatch(r'ubuntu(\d\d)(\d\d)', distro):
        return [f'ubuntu-{match[1]}.{match[2]}', 'ubuntu', 'debian', 'default']
    if match := re.fullmatch(r'fedora(\d+)', distro):
        return [f'fedora-{match[1]}', 'fedora', 'redhat', 'default']
    for prefix, name in (('rockylinux', 'rocky'), ('centos-stream', 'centos')):
        if match := re.fullmatch(prefix + r'(\d+)', distro):
            return [f'{name}-{match[1]}', name, f'el{match[1]}', 'redhat', 'default']
    sys.exit(f'{distro}: unknown distribution, add it to platform_keys()')


def resolve(app, entry, keys):
    """The source of an app on a platform, as a dict with its key and kind added."""
    key = next((k for k in keys if k in entry['sources']), 'none')
    source = entry['sources'].get(key, {'unavailable': f'no source for {keys[0]}'})
    kinds = [k for k in KINDS if k in source]
    if len(kinds) != 1:
        sys.exit(f"{app} ({key}): a source must have exactly one of {', '.join(KINDS)}")
    return {**source, 'key': key, 'kind': kinds[0]}


def log_message(app, source):
    """What the apps role logs for this source, from its 'Show where the apps come from' task."""
    return f"{app}: {source['kind']} {source[source['kind']]} ({source['key']})"


def tested_sources(log):
    """What a successful run of the apps scenario resolved, as {app: message}; empty otherwise."""
    if not log.exists():
        return {}
    text = log.read_text(encoding='utf-8', errors='replace')
    if 'apps > verify: Executed: Successful' not in text:
        return {}
    pattern = rf'^\s*"msg": ("([\w-]+): (?:{"|".join(KINDS)}) .*")$'
    return {match[2]: json.loads(match[1]) for match in re.finditer(pattern, text, re.MULTILINE)}


def cell(source, verified):
    if source['kind'] == 'unavailable':
        text = 'unavailable'
    else:
        names = source[source['kind']]
        names = names if isinstance(names, list) else [names]
        text = source['kind'] + ' ' + ', '.join(f'`{name}`' for name in names)
    return text + (MARK if verified else '')


def row(cells):
    return '| ' + ' | '.join(cells) + ' |'


def generate(catalog, distros, logs):
    tested = {d: tested_sources(logs / f'apps.{d}.log') for d in distros}
    lines = [row(['App', 'Description'] + distros), row(['---'] * (len(distros) + 2))]
    notes = {}
    for app, entry in sorted(catalog.items()):
        cells = [f'`{app}`', entry['description']]
        for distro in distros:
            source = resolve(app, entry, platform_keys(distro))
            message = log_message(app, source)
            found = tested[distro].get(app)
            if found and found != message:
                print(f'{distro}: the log has "{found}", the catalog gives "{message}"',
                      file=sys.stderr)
            cells.append(cell(source, found == message))
            note = source.get('why', source.get('unavailable'))
            if note:
                notes[app, source['key']] = note
        lines.append(row(cells))
    text = HEADER + '\n' + '\n'.join(lines) + '\n'
    if notes:
        text += '\n## Notes\n\n' + ''.join(f'- `{app}`, `{key}`: {note}\n'
                                           for (app, key), note in notes.items())
    return text


def main():
    parser = argparse.ArgumentParser(description='Generate docs/apps.md from the app catalog.')
    parser.add_argument('--check', action='store_true',
                        help='check that docs/apps.md is up to date with the catalog')
    parser.add_argument('--logs', type=Path, default=LOGS,
                        help='directory of the Molecule logs (default: %(default)s)')
    args = parser.parse_args()

    catalog = yaml.safe_load(CATALOG.read_text(encoding='utf-8'))['apps_catalog']
    distros = [line.strip() for line in DISTROS.read_text(encoding='utf-8').splitlines()
               if line.strip() and not line.startswith('#')]
    text = generate(catalog, distros, args.logs)

    if args.check:
        current = OUTPUT.read_text(encoding='utf-8') if OUTPUT.exists() else ''
        if current.replace(MARK, '') != text.replace(MARK, ''):
            sys.exit('docs/apps.md is out of date: run scripts/apps-table')
    else:
        OUTPUT.parent.mkdir(exist_ok=True)
        OUTPUT.write_text(text, encoding='utf-8')


if __name__ == '__main__':
    main()
