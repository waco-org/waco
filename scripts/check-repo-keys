#!/usr/bin/env python3

# Workstation as Code
# Copyright Nicola Musatti 2026.

"""check-repo-keys - check the repository signing keys shipped with the roles.

Only VirtualBox's key ships with a role (roles/virtualbox/files), because
Oracle's server too often answered 410 Gone. A shipped key goes stale when
Oracle rotates it, so this script, run weekly by CI, checks three things:

1. Oracle's repository metadata for each tested distribution (InRelease on
   Ubuntu, repomd.xml on Fedora and EL) verifies with the shipped key. This is
   the check that matters: a failure means the role can no longer install
   VirtualBox from the shipped key.
2. The key Oracle publishes has the shipped key's fingerprint. A difference is
   only a warning, and a failed download skips the check.
3. The shipped key has not expired, and does not expire within --warn-days.

It needs gpg and gpgv. Exit status: 0 if every check passed or only warned,
1 if a signature failed, the key expired or no metadata could be checked.
"""

import argparse
import os
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
DISTROS = ROOT / 'extensions/molecule/distros'

VIRTUALBOX_KEY = ROOT / 'roles/virtualbox/files/oracle_vbox_2016.asc'
VIRTUALBOX_KEY_URL = 'https://www.virtualbox.org/download/oracle_vbox_2016.asc'
VIRTUALBOX_BASE = 'https://download.virtualbox.org/virtualbox'

# Ubuntu releases by version, for Oracle's apt repository
UBUNTU_CODENAMES = {'2204': 'jammy', '2404': 'noble', '2604': 'resolute'}

IN_CI = os.environ.get('GITHUB_ACTIONS') == 'true'


def report(level, message):
    """Print a message, as a GitHub annotation when running in CI."""
    if IN_CI and level in ('warning', 'error'):
        print(f'::{level}::{message}')
    else:
        print(f'{level.upper():8} {message}')


def download(url, retries=3):
    """Return the content at url, retrying a few times."""
    for attempt in range(retries):
        try:
            request = urllib.request.Request(url, headers={'User-Agent': 'waco-check-repo-keys'})
            with urllib.request.urlopen(request, timeout=60) as response:
                return response.read()
        except (urllib.error.URLError, TimeoutError) as error:
            if attempt == retries - 1:
                raise
            report('info', f'{url}: {error}, retrying')
            time.sleep(5 * (attempt + 1))
    raise AssertionError('not reached')


def distros():
    """Return the tested distributions, from extensions/molecule/distros."""
    lines = DISTROS.read_text().splitlines()
    return [line.strip() for line in lines if line.strip() and not line.startswith('#')]


def metadata_urls(distro):
    """Return (signed file URL, detached signature URL or None) for Oracle's repository."""
    if distro.startswith('ubuntu'):
        codename = UBUNTU_CODENAMES[distro.removeprefix('ubuntu')]
        return f'{VIRTUALBOX_BASE}/debian/dists/{codename}/InRelease', None
    version = distro[len(distro.rstrip('0123456789')):]
    family = 'fedora' if distro.startswith('fedora') else 'el'  # else rockylinux, centos-stream
    repomd = f'{VIRTUALBOX_BASE}/rpm/{family}/{version}/x86_64/repodata/repomd.xml'
    return repomd, repomd + '.asc'


def gpg(home, *args, data=None):
    """Run gpg with its home in home and return its standard output."""
    result = subprocess.run(['gpg', '--homedir', str(home), '--batch', *args],
                            input=data, capture_output=True, check=True)
    return result.stdout


def key_info(home, armored):
    """Return (fingerprint, [(key kind, expiry timestamp or None)]) of an armored key."""
    output = gpg(home, '--show-keys', '--with-colons', data=armored).decode()
    fingerprint, keys = None, []
    for line in output.splitlines():
        fields = line.split(':')
        if fields[0] in ('pub', 'sub'):
            keys.append((fields[0], int(fields[6]) if fields[6] else None))
        elif fields[0] == 'fpr' and fingerprint is None:
            fingerprint = fields[9]
    return fingerprint, keys


def check_signatures(home, keyring, distro_list):
    """Verify Oracle's repository metadata; return (verified, failed) counts."""
    verified = failed = 0
    for distro in distro_list:
        signed_url, signature_url = metadata_urls(distro)
        try:
            signed = download(signed_url)
            signature = download(signature_url) if signature_url else None
        except (urllib.error.URLError, TimeoutError) as error:
            report('warning', f'{distro}: could not download {signed_url}: {error}; skipped')
            continue
        signed_file = home / 'signed'
        signed_file.write_bytes(signed)
        command = ['gpgv', '--keyring', str(keyring)]
        if signature is not None:
            signature_file = home / 'signed.asc'
            signature_file.write_bytes(signature)
            command.append(str(signature_file))
        command.append(str(signed_file))
        result = subprocess.run(command, capture_output=True, text=True)
        if result.returncode == 0:
            report('ok', f'{distro}: {signed_url} verifies with the shipped key')
            verified += 1
        else:
            report('error', f'{distro}: {signed_url} does NOT verify with the shipped key: '
                   + ' '.join(result.stderr.split()))
            failed += 1
    return verified, failed


def check_published(home, fingerprint):
    """Compare the shipped key with the one Oracle publishes."""
    try:
        published = download(VIRTUALBOX_KEY_URL)
    except (urllib.error.URLError, TimeoutError) as error:
        report('warning', f'could not download {VIRTUALBOX_KEY_URL}: {error}; comparison skipped')
        return
    published_fingerprint, _ = key_info(home, published)
    if published_fingerprint == fingerprint:
        report('ok', f'{VIRTUALBOX_KEY_URL} is the shipped key')
    else:
        report('warning', f'{VIRTUALBOX_KEY_URL} has fingerprint {published_fingerprint}, '
               f'the shipped key {fingerprint}: Oracle may have rotated its key')


def check_expiry(keys, warn_days):
    """Check the shipped key's expiry; return True if it has expired."""
    now = time.time()
    expired = False
    for kind, expiry in keys:
        if expiry is None:
            report('ok', f'shipped key ({kind}) has no expiry date')
        elif expiry <= now:
            report('error', f'shipped key ({kind}) expired on {time.strftime("%Y-%m-%d", time.gmtime(expiry))}')
            expired = expired or kind == 'pub'
        elif expiry <= now + warn_days * 86400:
            report('warning', f'shipped key ({kind}) expires on {time.strftime("%Y-%m-%d", time.gmtime(expiry))}')
        else:
            report('ok', f'shipped key ({kind}) expires on {time.strftime("%Y-%m-%d", time.gmtime(expiry))}')
    return expired


def main():
    parser = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
    parser.add_argument('-d', '--distro', action='append',
                        help='check only this distribution (repeatable); default: all tested ones')
    parser.add_argument('--key', type=Path, default=VIRTUALBOX_KEY,
                        help='check this key file instead of the shipped one (to test the script)')
    parser.add_argument('--warn-days', type=int, default=90,
                        help='warn when the key expires within this many days (default: 90)')
    args = parser.parse_args()

    distro_list = args.distro or distros()
    armored = args.key.read_bytes()
    with tempfile.TemporaryDirectory() as directory:
        home = Path(directory)
        home.chmod(0o700)
        keyring = home / 'shipped.gpg'
        keyring.write_bytes(gpg(home, '--dearmor', data=armored))
        fingerprint, keys = key_info(home, armored)
        report('info', f'shipped key {args.key}: {fingerprint}')

        verified, failed = check_signatures(home, keyring, distro_list)
        check_published(home, fingerprint)
        expired = check_expiry(keys, args.warn_days)

    if verified == 0 and failed == 0:
        report('error', 'no repository metadata could be checked')
        return 1
    return 1 if failed or expired else 0


if __name__ == '__main__':
    sys.exit(main())
